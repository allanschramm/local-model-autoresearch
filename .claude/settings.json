{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(nvidia-smi*)",
      "Bash(*check_hardware.py*)",
      "Bash(*verify_setup.py*)",
      "Bash(*setup-check*)",
      "Bash(*rank_results.py*)",
      "Bash(*-m pytest*)",
      "Bash(*-m unittest*)",
      "Bash(hf models *)",
      "Bash(hf repos *)",
      "Bash(hf file-size *)",
      "Bash(hf repo *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "WebFetch(domain:huggingface.co)"
    ],
    "ask": [
      "Bash(hf download *)",
      "Bash(*serve-config.py*)",
      "Bash(*model_up.py*)",
      "Bash(*benchmark_search.py*)",
      "Bash(*autoloop.py*)"
    ],
    "deny": [
      "Edit(.cursor/hooks.json)",
      "Write(.cursor/hooks.json)",
      "Edit(.cursor/rules/harness-trials.mdc)",
      "Write(.cursor/rules/harness-trials.mdc)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(scripts/hooks/**)",
      "Write(scripts/hooks/**)",
      "Bash(python* -c *)",
      "Bash(python.exe* -c *)",
      "Bash(*llama-cli*)",
      "Bash(*llama-server*)",
      "Bash(*llama-bench*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-adhoc-eval.ps1\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-adhoc-eval.ps1\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|Delete",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-gate-tamper.ps1\""
          }
        ]
      }
    ]
  }
}
